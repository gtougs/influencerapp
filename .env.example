# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/influencerapp

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_INFLUENCER_MONTHLY=price_xxx
STRIPE_PRICE_USER_MONTHLY=price_xxx

# AWS
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=influencerapp-media
AWS_CLOUDFRONT_DOMAIN=cdn.influencerapp.com
AWS_REGION=us-east-1

# RAG Service (internal)
RAG_SERVICE_URL=http://localhost:8001
RAG_SERVICE_SECRET=change-me-rag-internal-secret

# Email
RESEND_API_KEY=re_...

# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
